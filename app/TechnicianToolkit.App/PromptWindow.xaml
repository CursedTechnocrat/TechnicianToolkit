<Window x:Class="TechnicianToolkit.App.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        SizeToContent="Height"
        Width="470"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource Surface}"
        Title="Technician Toolkit">

  <Border BorderBrush="{StaticResource BorderBrushDim}" BorderThickness="1" Padding="24,20">
    <StackPanel>
      <TextBlock x:Name="CaptionText" Style="{StaticResource TagLabel}" Margin="0,0,0,10" />
      <TextBlock x:Name="MessageText" Style="{StaticResource BodyText}" Margin="0,0,0,16" />

      <!-- Filled in by the code-behind: a text field, a masked field, a
           credential pair, or nothing at all when the prompt is a choice. -->
      <StackPanel x:Name="InputHost" />

      <!-- Choice prompts put their answers here instead. -->
      <WrapPanel x:Name="ButtonHost" Margin="0,18,0,0" HorizontalAlignment="Right" />
    </StackPanel>
  </Border>
</Window>
