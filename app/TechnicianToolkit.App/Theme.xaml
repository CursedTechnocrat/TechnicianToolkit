  The palette is lifted verbatim from the HTML reports the suite already
  generates (the tk custom properties in TechnicianToolkit.psm1), so the app and
  the artifacts it produces read as one product rather than two.

  WPF's stock look is the main risk the plan called out for this phase, so every
  control a technician actually touches is templated here: scrollbars, buttons,
  text fields, dropdowns, checkboxes and list rows. Nothing is left at its
  default.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ─── Palette ──────────────────────────────────────────────────────────── -->
  <Color x:Key="BgColor">#FF0A0E14</Color>
  <Color x:Key="SurfaceColor">#FF111820</Color>
  <Color x:Key="Surface2Color">#FF162030</Color>
  <Color x:Key="BorderColor">#FF1E2D3D</Color>
  <Color x:Key="CyanColor">#FF00E5CC</Color>
  <Color x:Key="TextColor">#FFC8D4E0</Color>
  <Color x:Key="TextDimColor">#FF637587</Color>
  <Color x:Key="GreenColor">#FF3FB950</Color>
  <Color x:Key="YellowColor">#FFE3B341</Color>
  <Color x:Key="RedColor">#FFF85149</Color>
  <Color x:Key="BlueColor">#FF58A6FF</Color>
  <Color x:Key="MagentaColor">#FFC792EA</Color>

  <SolidColorBrush x:Key="Bg" Color="{StaticResource BgColor}" />
  <SolidColorBrush x:Key="Surface" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="Surface2" Color="{StaticResource Surface2Color}" />
  <SolidColorBrush x:Key="BorderBrushDim" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="Cyan" Color="{StaticResource CyanColor}" />
  <SolidColorBrush x:Key="Text" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="TextDim" Color="{StaticResource TextDimColor}" />
  <SolidColorBrush x:Key="Green" Color="{StaticResource GreenColor}" />
  <SolidColorBrush x:Key="Yellow" Color="{StaticResource YellowColor}" />
  <SolidColorBrush x:Key="Red" Color="{StaticResource RedColor}" />
  <SolidColorBrush x:Key="Blue" Color="{StaticResource BlueColor}" />
  <SolidColorBrush x:Key="Magenta" Color="{StaticResource MagentaColor}" />

  <SolidColorBrush x:Key="CyanDim" Color="{StaticResource CyanColor}" Opacity="0.12" />
  <SolidColorBrush x:Key="YellowDim" Color="{StaticResource YellowColor}" Opacity="0.12" />
  <SolidColorBrush x:Key="RedDim" Color="{StaticResource RedColor}" Opacity="0.12" />
  <SolidColorBrush x:Key="GreenDim" Color="{StaticResource GreenColor}" Opacity="0.12" />

  <!-- ─── Type ────────────────────────────────────────────────────────────── -->
  <!-- The reports pair a UI sans with a monospace for anything machine-ish.
       The same split applies here: monospace marks the parts that mirror a
       console, so a technician can tell at a glance what came from the tool. -->
  <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New, monospace</FontFamily>

  <!-- Small uppercase monospace label, the reports' section tag. -->
  <Style x:Key="TagLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="Foreground" Value="{StaticResource Cyan}" />
  </Style>

  <Style x:Key="DimLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="Foreground" Value="{StaticResource TextDim}" />
  </Style>

  <Style x:Key="BodyText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <!-- ─── ScrollBar ───────────────────────────────────────────────────────── -->
  <!-- The single biggest tell of an untouched WPF app. -->
  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Bar" Background="#FF243244" CornerRadius="3" Margin="3,0" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bar" Property="Background" Value="#FF33455C" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="11" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Style="{StaticResource ScrollThumb}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="11" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Grid Background="Transparent">
                <Track x:Name="PART_Track" IsDirectionReversed="False" Orientation="Horizontal">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False" />
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumb}" />
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False" />
                  </Track.IncreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ─── Buttons ─────────────────────────────────────────────────────────── -->
  <Style x:Key="PrimaryButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="#FF041014" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="20,9" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="{StaticResource Cyan}" CornerRadius="5">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="#FF4DF0DC" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Background" Value="#FF1E2D3D" />
              <Setter Property="Foreground" Value="{StaticResource TextDim}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="GhostButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Background="Transparent" CornerRadius="5"
                  BorderBrush="{StaticResource BorderBrushDim}" BorderThickness="1">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Surface2}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="#FF33455C" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="#FF3D4A5C" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
    <Setter Property="Foreground" Value="{StaticResource Red}" />
  </Style>

  <!-- ─── Text input ──────────────────────────────────────────────────────── -->
  <Style TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="CaretBrush" Value="{StaticResource Cyan}" />
    <Setter Property="SelectionBrush" Value="{StaticResource Cyan}" />
    <Setter Property="Padding" Value="9,7" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Chrome" Background="{StaticResource Bg}" CornerRadius="5"
                  BorderBrush="{StaticResource BorderBrushDim}" BorderThickness="1">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Cyan}" />
            </Trigger>
            <Trigger Property="Validation.HasError" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Red}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="PasswordBox">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="CaretBrush" Value="{StaticResource Cyan}" />
    <Setter Property="Padding" Value="9,7" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="PasswordBox">
          <Border x:Name="Chrome" Background="{StaticResource Bg}" CornerRadius="5"
                  BorderBrush="{StaticResource BorderBrushDim}" BorderThickness="1">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Cyan}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ─── ComboBox ────────────────────────────────────────────────────────── -->
  <Style x:Key="ComboToggle" TargetType="ToggleButton">
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Chrome" Background="{StaticResource Bg}" CornerRadius="5"
                  BorderBrush="{StaticResource BorderBrushDim}" BorderThickness="1">
            <Path x:Name="Arrow" HorizontalAlignment="Right" VerticalAlignment="Center"
                  Margin="0,0,11,0" Data="M 0 0 L 4 4 L 8 0" Stroke="{StaticResource TextDim}"
                  StrokeThickness="1.4" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Arrow" Property="Stroke" Value="{StaticResource Cyan}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Cyan}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Chrome" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Surface2}" />
              <Setter Property="Foreground" Value="{StaticResource Cyan}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="Height" Value="33" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Style="{StaticResource ComboToggle}"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                              Margin="11,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False" />
            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                   AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
              <Border Background="{StaticResource Surface}" CornerRadius="5" Margin="0,4,0,0"
                      BorderBrush="{StaticResource BorderBrushDim}" BorderThickness="1"
                      MinWidth="{TemplateBinding ActualWidth}">
                <ScrollViewer MaxHeight="260">
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ─── CheckBox ────────────────────────────────────────────────────────── -->
  <Style TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="Foreground" Value="{StaticResource Text}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Box" Width="17" Height="17" CornerRadius="4"
                    Background="{StaticResource Bg}" VerticalAlignment="Center"
                    BorderBrush="{StaticResource BorderBrushDim}" BorderThickness="1">
              <Path x:Name="Tick" Data="M 0 4 L 3.2 7.2 L 9 1" Stroke="#FF041014" StrokeThickness="2"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            </Border>
            <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource Cyan}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Cyan}" />
              <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Cyan}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource TextDim}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ─── Catalog rows ────────────────────────────────────────────────────── -->
  <Style x:Key="CatalogRow" TargetType="ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Chrome" Background="Transparent" CornerRadius="5" Padding="11,8"
                  Margin="0,1" BorderThickness="2,0,0,0" BorderBrush="Transparent">
            <ContentPresenter />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Surface2}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource CyanDim}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Cyan}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="PlainList" TargetType="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource CatalogRow}" />
  </Style>

  <!-- ─── Pane tabs ───────────────────────────────────────────────────────── -->
  <!-- RadioButtons rather than a TabControl: the panes share a header row with
       their own actions, and a TabControl would insist on owning that row. -->
  <Style x:Key="PaneTab" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="Foreground" Value="{StaticResource TextDim}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Margin" Value="0,0,4,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Chrome" Background="Transparent" CornerRadius="4" Padding="11,5">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Text}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource CyanDim}" />
              <Setter Property="Foreground" Value="{StaticResource Cyan}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ─── Badge ───────────────────────────────────────────────────────────── -->
  <Style x:Key="Badge" TargetType="Border">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="Margin" Value="0,0,6,0" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="BadgeText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="9.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

</ResourceDictionary>
