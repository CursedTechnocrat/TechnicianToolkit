<Window x:Class="TechnicianToolkit.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        Width="620" Height="580"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource Bg}"
        Title="Settings">

  <Grid Background="{StaticResource Bg}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#FF0D1219" BorderBrush="{StaticResource BorderBrushDim}"
            BorderThickness="0,0,0,1" Padding="24,16">
      <StackPanel>
        <TextBlock Text="SETTINGS" Style="{StaticResource TagLabel}" Margin="0,0,0,6" />
        <TextBlock Style="{StaticResource BodyText}" Foreground="{StaticResource TextDim}"
                   Text="Written through Set-TKConfig, the same way HEARTH writes it. The console tools read these too." />
      </StackPanel>
    </Border>

    <ScrollViewer Grid.Row="1" Padding="24,18" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="FieldHost" />
    </ScrollViewer>

    <Border Grid.Row="2" Background="{StaticResource Surface}"
            BorderBrush="{StaticResource BorderBrushDim}" BorderThickness="0,1,0,0" Padding="24,14">
      <Grid>
        <TextBlock x:Name="StatusText" Style="{StaticResource DimLabel}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Content="Cancel" Style="{StaticResource GhostButton}" Click="OnCancel" />
          <Button x:Name="SaveButton" Content="Save" Style="{StaticResource PrimaryButton}"
                  Margin="10,0,0,0" Click="OnSave" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
