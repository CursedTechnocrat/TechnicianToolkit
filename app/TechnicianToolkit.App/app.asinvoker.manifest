<?xml version="1.0" encoding="utf-8"?>
<!--
  Test-only manifest, following the precedent the phase 00 spike set. Identical
  to app.manifest except that it does not request elevation, so the window and
  the screenshot render mode can be launched from an unelevated shell without a
  UAC prompt. The shipping configuration is app.manifest (requireAdministrator);
  select this one by building with -p:Elevate=false.

  Note for anyone editing either manifest: Windows parses these as XML, so a
  double hyphen inside a comment makes the file invalid and the application
  fails to start with "side-by-side configuration is incorrect" - which names
  neither the file nor the reason.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="5.0.0.0" name="TechnicianToolkit" />
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
  <compatibility xmlns="urn:schemas-microsoft-com:compat.v1">
    <application>
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">permonitorv2,permonitor</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
