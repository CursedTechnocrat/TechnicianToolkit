<Window x:Class="TechnicianToolkit.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TechnicianToolkit.App"
        Title="Technician Toolkit"
        Width="1280" Height="820" MinWidth="940" MinHeight="600"
        Background="{StaticResource Bg}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

  <Window.Resources>
    <CollectionViewSource x:Key="CatalogView">
      <CollectionViewSource.GroupDescriptions>
        <PropertyGroupDescription PropertyName="Category" />
      </CollectionViewSource.GroupDescriptions>
    </CollectionViewSource>
  </Window.Resources>

  <!-- The root panel paints the background rather than relying on Window.Background:
       the screenshot render captures this element, not the window around it, so an
       unpainted root would come out transparent. -->
  <Grid Background="{StaticResource Bg}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ─── Title bar ──────────────────────────────────────────────────── -->
    <Border Grid.Row="0" Background="#FF0D1219" BorderBrush="{StaticResource BorderBrushDim}"
            BorderThickness="0,0,0,1" Padding="22,0" Height="54">
      <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="T.T." FontFamily="{StaticResource MonoFont}" FontSize="15"
                     FontWeight="Bold" Foreground="{StaticResource Cyan}" VerticalAlignment="Center" />
          <Border Width="1" Height="18" Background="{StaticResource BorderBrushDim}" Margin="14,0" />
          <TextBlock Text="TECHNICIAN TOOLKIT" FontFamily="{StaticResource MonoFont}" FontSize="12"
                     Foreground="{StaticResource Text}" VerticalAlignment="Center" />
          <TextBlock x:Name="VersionText" Text="5.0" FontFamily="{StaticResource MonoFont}"
                     FontSize="11" Foreground="{StaticResource TextDim}" Margin="10,0,0,0"
                     VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Content="Settings" Style="{StaticResource GhostButton}" Padding="12,5"
                  Margin="0,0,12,0" Click="OnOpenSettings" />
          <Border x:Name="ElevationBadge" Style="{StaticResource Badge}"
                  Background="{StaticResource GreenDim}">
            <TextBlock x:Name="ElevationText" Style="{StaticResource BadgeText}"
                       Text="ELEVATED" Foreground="{StaticResource Green}" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ─── Body ───────────────────────────────────────────────────────── -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320" MinWidth="240" />
        <ColumnDefinition Width="1" />
        <ColumnDefinition Width="*" MinWidth="480" />
      </Grid.ColumnDefinitions>

      <!-- Catalog -->
      <Border Grid.Column="0" Background="{StaticResource Surface}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="14,14,14,10">
            <TextBox x:Name="SearchBox" TextChanged="OnSearchChanged" />
            <TextBlock x:Name="SearchPlaceholder" Text="Search tools..." IsHitTestVisible="False"
                       FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                       Foreground="{StaticResource TextDim}" Margin="10,0,0,0"
                       VerticalAlignment="Center" />
          </Grid>

          <ListBox x:Name="CatalogList" Grid.Row="1" Margin="8,0,4,0"
                   Style="{StaticResource PlainList}"
                   ItemsSource="{Binding Source={StaticResource CatalogView}}"
                   SelectionChanged="OnToolSelected">
            <ListBox.GroupStyle>
              <GroupStyle>
                <GroupStyle.HeaderTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource TagLabel}"
                               Margin="11,16,0,6" />
                  </DataTemplate>
                </GroupStyle.HeaderTemplate>
              </GroupStyle>
            </ListBox.GroupStyle>

            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>

                  <TextBlock Grid.Column="0" Text="{Binding Key}" FontFamily="{StaticResource MonoFont}"
                             FontSize="11" Foreground="{StaticResource TextDim}" VerticalAlignment="Top"
                             Margin="0,2,0,0" />

                  <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding ShortName}" FontFamily="{StaticResource MonoFont}"
                                 FontSize="12.5" Foreground="{StaticResource Text}" />
                      <Border Style="{StaticResource Badge}" Background="{StaticResource YellowDim}"
                              Margin="8,0,0,0" Padding="5,1"
                              Visibility="{Binding AdminVisibility}">
                        <TextBlock Text="ADMIN" Style="{StaticResource BadgeText}"
                                   Foreground="{StaticResource Yellow}" />
                      </Border>
                      <Border Style="{StaticResource Badge}" Background="{StaticResource RedDim}"
                              Margin="4,0,0,0" Padding="5,1"
                              Visibility="{Binding DestructiveVisibility}">
                        <TextBlock Text="WRITES" Style="{StaticResource BadgeText}"
                                   Foreground="{StaticResource Red}" />
                      </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Description}" FontFamily="{StaticResource UiFont}"
                               FontSize="11" Foreground="{StaticResource TextDim}"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrushDim}" BorderThickness="0,1,0,0"
                  Padding="16,10">
            <TextBlock x:Name="CatalogCount" Style="{StaticResource DimLabel}" />
          </Border>
        </Grid>
      </Border>

      <Border Grid.Column="1" Background="{StaticResource BorderBrushDim}" />

      <!-- Detail + panes -->
      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" MinHeight="180" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="28,22" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource BorderBrushDim}" BorderThickness="0,0,0,1">
          <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
              <TextBlock x:Name="ToolName" FontFamily="{StaticResource MonoFont}" FontSize="19"
                         Foreground="{StaticResource Text}" VerticalAlignment="Center" />
              <TextBlock x:Name="ToolVersion" Style="{StaticResource DimLabel}"
                         Margin="12,0,12,0" VerticalAlignment="Center" />
              <ItemsControl x:Name="ToolBadges" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </StackPanel>

            <TextBlock x:Name="ToolDescription" Style="{StaticResource BodyText}"
                       Foreground="{StaticResource TextDim}" Margin="0,0,0,16" />

            <!-- The parameter form, generated from the script's own param() block. -->
            <ItemsControl x:Name="FormHost" Margin="0,0,0,4">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>

            <Grid Margin="0,16,0,0">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="RunButton" Content="Run" Style="{StaticResource PrimaryButton}"
                        Click="OnRun" IsEnabled="False" />
                <Button x:Name="QueueButton" Content="Add to queue" Style="{StaticResource GhostButton}"
                        Click="OnAddToQueue" IsEnabled="False" Margin="10,0,0,0" />
                <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource DangerButton}"
                        Click="OnCancel" IsEnabled="False" Margin="10,0,0,0" />
              </StackPanel>

              <StackPanel x:Name="ProgressPanel" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Visibility="Collapsed" MaxWidth="380">
                <TextBlock x:Name="ProgressText" Style="{StaticResource DimLabel}"
                           TextTrimming="CharacterEllipsis" Margin="0,0,0,5" />
                <Border Background="{StaticResource Surface2}" CornerRadius="3" Height="5" Width="260"
                        HorizontalAlignment="Right">
                  <Border x:Name="ProgressBarFill" Background="{StaticResource Cyan}" CornerRadius="3"
                          HorizontalAlignment="Left" Width="0" />
                </Border>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <!-- Panes -->
        <Grid Grid.Row="1" Background="{StaticResource Bg}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Border Grid.Row="0" Padding="22,8" Background="#FF0D1219"
                  BorderBrush="{StaticResource BorderBrushDim}" BorderThickness="0,0,0,1">
            <Grid>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <RadioButton x:Name="TabOutput" Style="{StaticResource PaneTab}" Content="OUTPUT"
                             IsChecked="True" Checked="OnPaneChanged" />
                <RadioButton x:Name="TabReports" Style="{StaticResource PaneTab}" Content="REPORTS"
                             Checked="OnPaneChanged" />
                <RadioButton x:Name="TabHistory" Style="{StaticResource PaneTab}" Content="HISTORY"
                             Checked="OnPaneChanged" />
                <RadioButton x:Name="TabQueue" Style="{StaticResource PaneTab}" Content="QUEUE"
                             Checked="OnPaneChanged" />
                <TextBlock x:Name="PaneCount" Style="{StaticResource DimLabel}" Margin="12,0,0,0"
                           VerticalAlignment="Center" />
              </StackPanel>

              <StackPanel x:Name="OutputActions" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Copy" Style="{StaticResource GhostButton}" Padding="12,5"
                        Click="OnCopyOutput" />
                <Button Content="Save" Style="{StaticResource GhostButton}" Padding="12,5"
                        Margin="8,0,0,0" Click="OnSaveOutput" />
                <Button Content="Clear" Style="{StaticResource GhostButton}" Padding="12,5"
                        Margin="8,0,0,0" Click="OnClearOutput" />
              </StackPanel>

              <StackPanel x:Name="ReportActions" Orientation="Horizontal" HorizontalAlignment="Right"
                          Visibility="Collapsed">
                <Button Content="Open folder" Style="{StaticResource GhostButton}" Padding="12,5"
                        Click="OnOpenReportFolder" />
                <Button Content="Refresh" Style="{StaticResource GhostButton}" Padding="12,5"
                        Margin="8,0,0,0" Click="OnRefreshReports" />
              </StackPanel>

              <StackPanel x:Name="HistoryActions" Orientation="Horizontal" HorizontalAlignment="Right"
                          Visibility="Collapsed">
                <Button Content="Clear history" Style="{StaticResource GhostButton}" Padding="12,5"
                        Click="OnClearHistory" />
              </StackPanel>

              <StackPanel x:Name="QueueActions" Orientation="Horizontal" HorizontalAlignment="Right"
                          Visibility="Collapsed">
                <Button x:Name="RunQueueButton" Content="Run queue" Style="{StaticResource PrimaryButton}"
                        Padding="14,5" Click="OnRunQueue" />
                <Button Content="Remove" Style="{StaticResource GhostButton}" Padding="12,5"
                        Margin="8,0,0,0" Click="OnRemoveQueued" />
                <Button Content="Clear" Style="{StaticResource GhostButton}" Padding="12,5"
                        Margin="8,0,0,0" Click="OnClearQueue" />
              </StackPanel>
            </Grid>
          </Border>

          <Grid Grid.Row="1">
            <!-- OUTPUT -->
            <Grid x:Name="OutputPane">
              <ListBox x:Name="OutputList" Background="Transparent" BorderThickness="0"
                       Padding="22,12" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                       VirtualizingStackPanel.IsVirtualizing="True"
                       VirtualizingStackPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Template">
                      <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                          <ContentPresenter />
                        </ControlTemplate>
                      </Setter.Value>
                    </Setter>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock local:InlineBinder.Segments="{Binding Segments}"
                               FontFamily="{StaticResource MonoFont}" FontSize="12.5"
                               Foreground="{StaticResource Text}" TextWrapping="NoWrap"
                               LineHeight="17" />
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <TextBlock x:Name="OutputEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Style="{StaticResource DimLabel}" Text="Select a tool and press Run." />
            </Grid>

            <!-- REPORTS -->
            <Grid x:Name="ReportsPane" Visibility="Collapsed">
              <ListBox x:Name="ReportsList" Style="{StaticResource PlainList}" Margin="14,10"
                       MouseDoubleClick="OnOpenReport">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding FileName}" FontFamily="{StaticResource MonoFont}"
                                   FontSize="12.5" Foreground="{StaticResource Text}" />
                        <TextBlock FontFamily="{StaticResource UiFont}" FontSize="11"
                                   Foreground="{StaticResource TextDim}" Margin="0,2,0,0">
                          <Run Text="{Binding ToolName, Mode=OneWay}" />
                          <Run Text="  ·  " />
                          <Run Text="{Binding SizeDisplay, Mode=OneWay}" />
                        </TextBlock>
                      </StackPanel>
                      <TextBlock Grid.Column="1" Style="{StaticResource DimLabel}" VerticalAlignment="Center"
                                 Text="{Binding WrittenLocalDisplay}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <TextBlock x:Name="ReportsEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Style="{StaticResource DimLabel}"
                         Text="No reports yet. Run a tool that generates one." />
            </Grid>

            <!-- HISTORY -->
            <Grid x:Name="HistoryPane" Visibility="Collapsed">
              <ListBox x:Name="HistoryList" Style="{StaticResource PlainList}" Margin="14,10"
                       MouseDoubleClick="OnOpenHistoryArtifact">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>

                      <Border Grid.Column="0" Style="{StaticResource Badge}" Padding="7,2"
                              Background="{Binding OutcomeBackground}" VerticalAlignment="Top"
                              Margin="0,1,10,0">
                        <TextBlock Text="{Binding Record.OutcomeDisplay}"
                                   Style="{StaticResource BadgeText}"
                                   Foreground="{Binding OutcomeForeground}" />
                      </Border>

                      <StackPanel Grid.Column="1">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="{Binding Record.Tool}" FontFamily="{StaticResource MonoFont}"
                                     FontSize="12.5" Foreground="{StaticResource Text}" />
                          <TextBlock Text="{Binding ParametersDisplay}" Style="{StaticResource DimLabel}"
                                     Margin="10,1,0,0" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Text="{Binding ArtifactsDisplay}" FontFamily="{StaticResource UiFont}"
                                   FontSize="11" Foreground="{StaticResource TextDim}"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                      </StackPanel>

                      <TextBlock Grid.Column="2" Style="{StaticResource DimLabel}" VerticalAlignment="Top"
                                 TextAlignment="Right" Text="{Binding WhenDisplay}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <TextBlock x:Name="HistoryEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Style="{StaticResource DimLabel}" Text="Nothing has run yet." />
            </Grid>

            <!-- QUEUE -->
            <Grid x:Name="QueuePane" Visibility="Collapsed">
              <ListBox x:Name="QueueList" Style="{StaticResource PlainList}" Margin="14,10">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Grid.Column="0" Text="{Binding Position}" Style="{StaticResource DimLabel}"
                                 VerticalAlignment="Center" />
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Tool.ShortName}" FontFamily="{StaticResource MonoFont}"
                                   FontSize="12.5" Foreground="{StaticResource Text}" />
                        <TextBlock Text="{Binding ParametersDisplay}" FontFamily="{StaticResource UiFont}"
                                   FontSize="11" Foreground="{StaticResource TextDim}"
                                   TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding StateDisplay}"
                                 Style="{StaticResource DimLabel}" VerticalAlignment="Center" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

              <TextBlock x:Name="QueueEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Style="{StaticResource DimLabel}" TextAlignment="Center"
                         Text="Nothing queued.&#10;Pick a tool, set its parameters, and choose Add to queue." />
            </Grid>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
