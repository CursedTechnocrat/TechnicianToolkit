# ─── Runtime Output ───────────────────────────────────────────────────────────
# AUSPEX — HTML diagnostic reports (saved to Desktop by default)
AUSPEX_*.html

# RUNEPRESS — CSV install logs (saved alongside the script)
RUNEPRESS_InstallLog_*.csv

# RESTORATION — transcript logs (saved to %TEMP%, but guard against local copies)
RESTORATION_*.log

# ─── General Log / Report Files ───────────────────────────────────────────────
*.log
*.csv
*.html

# Write-TKError's monthly error log — lands beside the scripts whenever a tool
# (or the test suite) runs from a checkout with no LogDirectory configured.
TK_Errors_*.jsonl

# ─── Windows & PowerShell ─────────────────────────────────────────────────────
# PowerShell transcript files
*_transcript_*.txt

# Compiled script caches
*.ps1xml~

# ─── OS Artifacts ─────────────────────────────────────────────────────────────
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS (if ever opened on a Mac)
.DS_Store

# ─── Editor & IDE ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.code-workspace

# Visual Studio per-user cache. Appeared once the app/ solution was opened
# locally; it is machine-specific state and must never be committed.
.vs/

# ─── Claude Code ──────────────────────────────────────────────────────────────
.claude/settings.local.json

# ─── .NET build output ────────────────────────────────────────────────────────
# The launcher prototype was only ever built in CI, so the repo had no .NET
# ignores. The desktop app is built locally, so it needs them.
bin/
obj/
dist/
dist-*/

# Phase 00 spike probe reports
probe-*.txt
